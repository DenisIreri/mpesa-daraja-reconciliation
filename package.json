{
  "name": "mpesa-daraja-reconciliation",
  "version": "0.1.0",
  "description": "M-Pesa STK Push (Daraja sandbox) with idempotent callbacks and order reconciliation, in TypeScript.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "reconcile": "tsx src/cli-reconcile.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
