# Get these from https://developer.safaricom.co.ke (create a sandbox app).
# Never commit a real .env file.
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
# Public HTTPS URL that Safaricom will POST the STK callback to (e.g. an ngrok tunnel in dev).
DARAJA_CALLBACK_URL=https://example.ngrok.app/mpesa/callback
# Shared secret added to the callback URL as ?token=... so random POSTs are rejected.
CALLBACK_TOKEN=change-me
PORT=3000
